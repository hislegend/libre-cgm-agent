# libre-cgm 설정 — 이 파일은 ~/.config/libre-cgm/config.env 로 복사되고 권한 600 이 된다.

# [필수] 보호자(LibreLinkUp) 계정 이메일 — 본인 리브레 계정과 다른 새 이메일
LLU_EMAIL=

# [Linux 필수 / macOS 선택] 비밀번호.
# macOS는 여기 비워 두고 키체인에 넣는 걸 권장:
#   security add-generic-password -s libre-cgm -a "<LLU_EMAIL>" -w
LLU_PASSWORD=

# [선택] 서버 지역. 비우면 로그인 때 자동으로 맞춘다 (AP·EU·US·JP·AU …)
LLU_REGION=

# [선택] 저장 폴더
# CGM_DATA_DIR=~/.local/share/libre-cgm

# [선택] 위험 알림 — 텔레그램 봇 토큰과 받을 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [선택] 알림 기준 mg/dL
# CGM_LOW=70
# CGM_HIGH=250
